<div class="card project-card shadow-sm mb-4"
    data-status="{{status}}"
    data-priority="{{priority}}"
    data-category="{{category}}"
   style="--projectColor: {{color}};">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-start">

            <div>

                <h4 class="fw-bold mb-1">
                    <i class="{{iconClass}} me-2"></i>
                    {{title}}
                </h4>

                <p class="text-muted mb-2">
                    {{description}}
                </p>

                <span class="badge bg-primary me-2">
                    {{category}}
                </span>

                <span class="badge {{priorityClass}}">
                    {{priority}}
                </span>

            </div>

            <span class="badge {{badgeClass}}">
                {{status}}
            </span>

        </div>

        <hr>

        <div class="d-flex justify-content-between mb-2">

            <span data-i18n="projects.progress">İlerleme</span>

            <strong id="progress-{{_id}}">
                0%
            </strong>

        </div>

        <div class="progress mb-4" style="height:10px">

            <div
                id="progressBar-{{_id}}"
                class="progress-bar"
                style="width:0%">
            </div>

        </div>

        <div class="row text-center">

            <div class="col">

                <h5 id="taskCount-{{_id}}">
                    0
                </h5>

                <small class="text-muted" data-i18n="dashboard.taskCount">
                    Toplam Görev
                </small>

            </div>

            <div class="col">

                <h5 id="completedCount-{{_id}}">
                    0
                </h5>

                <small class="text-muted" data-i18n="profile.completedTasks">
                    Tamamlanan
                </small>

            </div>

            <div class="col">

                <h5 id="activeCount-{{_id}}">
                    0
                </h5>

                <small class="text-muted" data-i18n="dashboard.activeTasks">
                    Devam Eden
                </small>

            </div>

        </div>

        <hr>

      <div class="d-flex justify-content-between align-items-center">

    <small class="text-muted">
        <i class="fa-regular fa-calendar me-1"></i>
        {{deadline}}
    </small>

    <div class="d-flex gap-2">

        <button
            class="btn btn-outline-danger btn-sm deleteProject"
            data-id="{{_id}}">
            <i class="fa-solid fa-trash"></i>
        </button>

        <button
            class="btn btn-primary btn-sm openProject"
            data-id="{{_id}}">
            Aç →
        </button>

    </div>

</div>

    </div>

</div>